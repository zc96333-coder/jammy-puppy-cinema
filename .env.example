# Copy to .env locally. Never commit the filled file or send passwords in chat.
# Empty passwords enable local-loopback PREVIEW mode only.
PUPPY_PASSWORD=
JAMMY_PASSWORD=
NODE_ENV=development
PORT=4173
# Required HTTPS origin in production (with a reverse proxy or cloud gateway).
PUBLIC_ORIGIN=
# Optional local database path, outside the static assets directory.
DATABASE_FILE=
